{
  "openapi": "3.0.3",
  "info": {
    "title": "AutoScrape Data API",
    "description": "No-key evaluation REST API plus paid x402 mirrors for US public-data evidence: business filings across 16 no-key states, building permits, SEC EDGAR, IRS 990 nonprofits, WHOIS domain lookup, and stock price data. Paid x402 routes are listed first for agent/payment crawlers and settle through PayAPI-compatible x402 facilitators (CDP + Dexter) at $0.0100/request. CA business filings require a keyed source and are not enabled on the open pilot. SC currently requires browser CAPTCHA verification and is not enabled for authoritative no-key automated search.",
    "version": "1.0.0",
    "contact": {
      "name": "Ava Torres",
      "email": "avatorresdev@gmail.com",
      "url": "https://www.payapi.market/provider/ava-torres"
    }
  },
  "servers": [
    {
      "url": "https://autoscrape-api-seven.vercel.app"
    }
  ],
  "paths": {
    "/x402/v1/business-entity/search": {
      "get": {
        "operationId": "paidX402SearchBusinessEntities",
        "summary": "KYB merchant underwriting business entity registry evidence",
        "tags": [
          "x402 paid",
          "Business Entity"
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "Apple Inc"
            },
            "description": "Business name to search. Defaults to Apple Inc with a warning when omitted for marketplace/agent discovery."
          },
          {
            "name": "states",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated state codes (default: NY with warning). Also accepts 'state' param."
          },
          {
            "name": "maxResults",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 25
            },
            "description": "Maximum records to return across the response"
          },
          {
            "name": "fetchDetails",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Include full entity details"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "402": {
            "description": "Payment required. Response includes PAYMENT-REQUIRED header with x402 challenge and Bazaar discovery metadata.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 payment challenge",
                "schema": {
                  "type": "string"
                }
              },
              "PAYMENT-RESPONSE": {
                "description": "x402 settlement response when payment succeeds",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Paid x402 API for KYB merchant underwriting, business verification, legal entity verification, vendor due diligence, and official-source company registry evidence. Returns HTTP 402 Payment Required until a valid x402 payment is supplied. Price: $0.0100/request on Base USDC via CDP/Dexter x402 facilitators; public no-key demo remains available at /v1/business-entity/search.",
        "x-payment-info": {
          "x402Version": "2",
          "scheme": "exact",
          "network": "eip155:8453",
          "asset": "USDC",
          "price": "$0.0100",
          "payTo": "0xb50bcA6e8ec9D0cA76C77965A0E1AA15a68fDAc2",
          "facilitator": "https://api.cdp.coinbase.com/platform/v2/x402",
          "facilitators": [
            "https://api.cdp.coinbase.com/platform/v2/x402",
            "https://x402.dexter.cash"
          ],
          "resource": "https://autoscrape-api-seven.vercel.app/x402/v1/business-entity/search",
          "discovery": "https://autoscrape-api-seven.vercel.app/.well-known/x402.json",
          "example": "https://autoscrape-api-seven.vercel.app/x402/v1/business-entity/search?query=Apple%20Inc&states=NY,TX&maxResults=3&fetchDetails=true"
        }
      }
    },
